#!/usr/bin/env bash
# jules-gate - Universal CLI orchestrator and verification gate for Google Jules
# Works universally across Antigravity, Gemini, VS Code, JetBrains, Cursor, and Terminal.

set -euo pipefail

# Resolve script directory (handling symlinks)
SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
  DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"

if [[ -d "$ROOT_DIR/scripts" ]]; then
    SCRIPTS_DIR="$ROOT_DIR/scripts"
elif [[ -d "$HOME/.gemini/config/plugins/jules-plugin/scripts" ]]; then
    SCRIPTS_DIR="$HOME/.gemini/config/plugins/jules-plugin/scripts"
else
    echo "❌ Error: Could not locate jules-plugin scripts directory."
    exit 1
fi

usage() {
    cat << 'EOF'
Usage: jules-gate <command> [arguments...]

Commands:
  wait <session_id...> [--timeout MINS] [--interactive|-i]  Poll and wait for Jules session(s). With --interactive, auto-answers boilerplate prompts.
  verify <session_id> [base_branch] [--sandbox] [--retry-flaky <N>] [--skip-ci]  Pull patch, checkout isolated review branch, run tests, and gate.
  merge <session_id> [base] [--no-rebase] [--delete-remote] [--sandbox] [--retry-flaky <N>] [--skip-ci] Verify, auto-rebase, and merge review branch.
  pr <session_id> [base_branch] [--sandbox] [--retry-flaky <N>] [--skip-ci] [--title <title>] [--auto-merge] Verify and push review branch, opening a verified GitHub PR via `gh`.
  pr-merge <branch_or_session_id> [base_branch] [--skip-ci] Verify local tests, merge open GitHub PR into base branch, and sync local workspace.
  review-branch <branch_or_session_id> [base_branch] [--repo <owner/repo>] Dispatch EULIS code review of a branch relative to base branch.
  lint <repo> [prompt_file]              Pre-flight contract linter to validate repo connection and prompt spec.
  tokens [--json] [--reset]              Display cumulative estimated tokens spared across sessions.
  inspect <session_id> [--json]          Inspect activity stream & extract interactive question from Jules.
  interact <session_id> <msg_or_file>    Send answer directly into running Jules Cloud VM to resume execution.
  auto-answer <session_id>               Evaluate auto-answer heuristics and unblock boilerplate prompts autonomously.
  close [session_id]                     Open Jules session to close it.
  reply [session_id] [file_or_msg]       Copy failure trace and open Jules session for in-VM repair.
  web [session_id]                       Open Jules session or dashboard in the default browser.
  workflow <validate|run|waves> <file> [options] Validate or execute DAG task workflows.
  ps [flags]                             List remote Jules sessions and statuses.
  status                                 Check and display plugin version, scripts, and Jules CLI status.
  help                                   Show this help message.
EOF
    exit 1
}

open_browser_url() {
    local url="$1"
    if [[ "${JULES_GATE_NO_BROWSER:-}" == "1" || "${CI:-}" == "true" || "${TESTING:-}" == "true" ]]; then
        return 0
    fi
    if command -v open >/dev/null 2>&1; then
        open "$url" 2>/dev/null || true
    elif command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$url" 2>/dev/null || true
    fi
}

resolve_gh_token() {
    if [[ -n "${GH_TOKEN:-}" ]]; then
        export GH_TOKEN
        return 0
    fi
    if ! command -v gh >/dev/null 2>&1; then
        return 0
    fi
    local REPO_OWNER="${JULES_GATE_GH_USER:-}"
    if [[ -z "$REPO_OWNER" ]]; then
        local remote_url
        remote_url=$(git remote get-url origin 2>/dev/null || true)
        if [[ -n "$remote_url" ]]; then
            REPO_OWNER=$(echo "$remote_url" | sed -E 's#.*github\.com[:/]([^/]+)/.*#\1#' || true)
        fi
    fi
    if [[ -n "$REPO_OWNER" ]]; then
        GH_TOKEN=$(gh auth token --user "$REPO_OWNER" 2>/dev/null || gh auth token) || true
    else
        GH_TOKEN=$(gh auth token 2>/dev/null || true)
    fi
    if [[ -n "$GH_TOKEN" ]]; then
        export GH_TOKEN
    fi
}

with_git_lock() {
    local git_dir
    git_dir="$(git rev-parse --git-dir 2>/dev/null || echo '.git')"
    local lock_dir="$git_dir/jules_merge.lock.d"
    local max_wait=60
    local start_time
    start_time=$(date +%s)
    
    while true; do
        if mkdir "$lock_dir" 2>/dev/null; then
            break
        fi
        local now
        now=$(date +%s)
        local elapsed=$(( now - start_time ))
        if [[ $elapsed -ge $max_wait ]]; then
            echo "⚠️  [LOCK TIMEOUT] Waited ${max_wait}s for git merge lock ($lock_dir). Cleaning stale lock..." >&2
            rm -rf "$lock_dir" 2>/dev/null || true
            mkdir "$lock_dir" 2>/dev/null && break
        fi
        sleep 1
    done
    
    local rc=0
    "$@" || rc=$?
    
    rm -rf "$lock_dir" 2>/dev/null || true
    return "$rc"
}

if [[ $# -lt 1 ]]; then
    usage
fi

CMD="$1"
shift

case "$CMD" in
    wait)
        exec "$SCRIPTS_DIR/jules_poll_wait.sh" "$@"
        ;;
    verify)
        SESSION_ID="$1"
        shift
        BASE_BRANCH=""
        WORKTREE_ARGS=""
        if [[ "${JULES_GATE_SKIP_CI:-}" == "1" ]]; then
            WORKTREE_ARGS="$WORKTREE_ARGS --skip-ci"
        fi
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --sandbox)
                    WORKTREE_ARGS="$WORKTREE_ARGS --sandbox"
                    shift
                    ;;
                --retry-flaky)
                    WORKTREE_ARGS="$WORKTREE_ARGS --retry-flaky $2"
                    shift 2
                    ;;
                --skip-ci)
                    WORKTREE_ARGS="$WORKTREE_ARGS --skip-ci"
                    shift
                    ;;
                --allow-failed)
                    WORKTREE_ARGS="$WORKTREE_ARGS --allow-failed"
                    shift
                    ;;
                *)
                    if [[ -z "$BASE_BRANCH" ]]; then
                        BASE_BRANCH="$1"
                    else
                        WORKTREE_ARGS="$WORKTREE_ARGS $1"
                    fi
                    shift
                    ;;
            esac
        done
        eval "exec \"$SCRIPTS_DIR/worktree_gate.sh\" \"$SESSION_ID\" \"$BASE_BRANCH\" $WORKTREE_ARGS"
        ;;
    merge)
        SESSION_ID="$1"
        shift
        BASE_BRANCH=""
        DELETE_REMOTE=false
        AUTO_REBASE=true
        SKIP_CI=false
        WORKTREE_ARGS=""
        if [[ "${JULES_GATE_SKIP_CI:-}" == "1" ]]; then
            SKIP_CI=true
            WORKTREE_ARGS="$WORKTREE_ARGS --skip-ci"
        fi
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --delete-remote)
                    DELETE_REMOTE=true
                    shift
                    ;;
                --no-rebase)
                    AUTO_REBASE=false
                    shift
                    ;;
                --sandbox)
                    WORKTREE_ARGS="$WORKTREE_ARGS --sandbox"
                    shift
                    ;;
                --retry-flaky)
                    WORKTREE_ARGS="$WORKTREE_ARGS --retry-flaky $2"
                    shift 2
                    ;;
                --skip-ci)
                    SKIP_CI=true
                    WORKTREE_ARGS="$WORKTREE_ARGS --skip-ci"
                    shift
                    ;;
                --allow-failed)
                    WORKTREE_ARGS="$WORKTREE_ARGS --allow-failed"
                    shift
                    ;;
                *)
                    if [[ -z "$BASE_BRANCH" ]]; then
                        BASE_BRANCH="$1"
                    else
                        WORKTREE_ARGS="$WORKTREE_ARGS $1"
                    fi
                    shift
                    ;;
            esac
        done
        BASE_BRANCH="${BASE_BRANCH:-$(git branch --show-current 2>/dev/null || echo 'main')}"
        if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
            if [[ "$BASE_BRANCH" == "main" ]] && git rev-parse --verify "master" >/dev/null 2>&1; then
                BASE_BRANCH="master"
            elif [[ "$BASE_BRANCH" == "master" ]] && git rev-parse --verify "main" >/dev/null 2>&1; then
                BASE_BRANCH="main"
            fi
        fi
        REVIEW_BRANCH="jules/review-${SESSION_ID}"
        
        # Strict Interactive Guard: Refuse to merge if task is in interactive state
        if command -v jules >/dev/null 2>&1; then
            REMOTE_STATE=$(jules remote list --session 2>/dev/null | grep -E "\b$SESSION_ID\b" || true)
            if echo "$REMOTE_STATE" | grep -qiE "Awaiting User"; then
                echo "❌ [STRICT GUARD ERROR] Cannot merge session $SESSION_ID:"
                echo "   The remote session is currently in an INTERACTIVE state (Awaiting User Feedback)."
                echo "   Rules mandate that interactive tasks must NOT be merged or considered completed."
                echo "   💡 Action: Run 'jules-gate inspect $SESSION_ID' to see the question, and 'jules-gate interact $SESSION_ID \"<answer>\"' to resolve it."
                exit 5
            fi
        fi

        # Pass extra WORKTREE_ARGS which may contain --sandbox, --retry-flaky, --skip-ci, etc.
        # eval is used carefully to correctly expand arguments like --retry-flaky 2
        eval "\"$SCRIPTS_DIR/worktree_gate.sh\" \"$SESSION_ID\" \"$BASE_BRANCH\" $WORKTREE_ARGS"
        
        perform_merge() {
            if [[ "$AUTO_REBASE" == "true" ]]; then
                MERGE_BASE=$(git merge-base "$REVIEW_BRANCH" "$BASE_BRANCH" 2>/dev/null || true)
                BASE_HEAD=$(git rev-parse "$BASE_BRANCH" 2>/dev/null || true)
                if [[ -n "$MERGE_BASE" && -n "$BASE_HEAD" && "$MERGE_BASE" != "$BASE_HEAD" ]]; then
                    echo "==> Serialized Rebase: Base branch $BASE_BRANCH has advanced. Auto-rebasing $REVIEW_BRANCH..."
                    git checkout "$REVIEW_BRANCH"
                    if ! git rebase "$BASE_BRANCH"; then
                        echo "❌ Semantic or textual conflict during rebase of $REVIEW_BRANCH onto $BASE_BRANCH. Aborting."
                        git rebase --abort
                        return 4
                    fi
                    echo "✅ Successfully rebased $REVIEW_BRANCH onto $BASE_BRANCH"
                fi
            fi
            
            echo "==> Merging $REVIEW_BRANCH into $BASE_BRANCH..."
            git checkout "$BASE_BRANCH"
            MERGE_MSG="merge(jules): integrate verified changes from session $SESSION_ID"
            if [[ "$SKIP_CI" == "true" ]]; then
                MERGE_MSG="$MERGE_MSG [skip ci]"
            fi
            git merge --no-ff "$REVIEW_BRANCH" -m "$MERGE_MSG"
            git branch -d "$REVIEW_BRANCH"
            echo "✅ Successfully merged and cleaned up $REVIEW_BRANCH"
            echo "🌐 Jules Web Task: https://jules.google.com/task/$SESSION_ID"
            echo "💡 Tip: If this session is in 'Awaiting User Feedback' on jules.google.com, you can safely Accept or Close it."
            if [[ "$DELETE_REMOTE" == "true" ]]; then
                echo "==> Deleting remote review branch origin/$REVIEW_BRANCH if present..."
                git push origin --delete "$REVIEW_BRANCH" 2>/dev/null || true
            fi
        }
        with_git_lock perform_merge
        ;;
    pr)
        SESSION_ID="$1"
        shift
        BASE_BRANCH=""
        WORKTREE_ARGS=""
        SKIP_CI=false
        CUSTOM_TITLE=""
        AUTO_MERGE=false
        if [[ "${JULES_GATE_SKIP_CI:-}" == "1" ]]; then
            SKIP_CI=true
            WORKTREE_ARGS="$WORKTREE_ARGS --skip-ci"
        fi
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --sandbox)
                    WORKTREE_ARGS="$WORKTREE_ARGS --sandbox"
                    shift
                    ;;
                --retry-flaky)
                    WORKTREE_ARGS="$WORKTREE_ARGS --retry-flaky $2"
                    shift 2
                    ;;
                --skip-ci)
                    SKIP_CI=true
                    WORKTREE_ARGS="$WORKTREE_ARGS --skip-ci"
                    shift
                    ;;
                --title)
                    CUSTOM_TITLE="$2"
                    shift 2
                    ;;
                --auto-merge)
                    AUTO_MERGE=true
                    shift
                    ;;
                --allow-failed)
                    WORKTREE_ARGS="$WORKTREE_ARGS --allow-failed"
                    shift
                    ;;
                *)
                    if [[ -z "$BASE_BRANCH" ]]; then
                        BASE_BRANCH="$1"
                    else
                        WORKTREE_ARGS="$WORKTREE_ARGS $1"
                    fi
                    shift
                    ;;
            esac
        done

        BASE_BRANCH="${BASE_BRANCH:-$(git branch --show-current 2>/dev/null || echo 'main')}"
        if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
            if [[ "$BASE_BRANCH" == "main" ]] && git rev-parse --verify "master" >/dev/null 2>&1; then
                BASE_BRANCH="master"
            elif [[ "$BASE_BRANCH" == "master" ]] && git rev-parse --verify "main" >/dev/null 2>&1; then
                BASE_BRANCH="main"
            fi
        fi
        REVIEW_BRANCH="jules/review-${SESSION_ID}"
        
        eval "\"$SCRIPTS_DIR/worktree_gate.sh\" \"$SESSION_ID\" \"$BASE_BRANCH\" $WORKTREE_ARGS"

        # Calculate session diff and spared tokens for PR badge
        NUMSTAT=$(git diff --numstat "$BASE_BRANCH...$REVIEW_BRANCH" 2>/dev/null || echo "0 0")
        LINES_ADDED=$(echo "$NUMSTAT" | awk '{sum+=$1} END {print sum+0}')
        LINES_REMOVED=$(echo "$NUMSTAT" | awk '{sum+=$2} END {print sum+0}')
        DIFF_LINES=$(( LINES_ADDED + LINES_REMOVED ))
        SESSION_TOKENS=$(( 35000 + DIFF_LINES * 5 ))

        PR_BODY=$(cat << EOF
### Automated Verified Changes from Jules Session $SESSION_ID

All tests passed on isolated review branch \`$REVIEW_BRANCH\` against base \`$BASE_BRANCH\`.

---
⚡ **Verified by Jules Gate:** \`~$SESSION_TOKENS tokens spared\` (+$LINES_ADDED / -$LINES_REMOVED lines across isolated review worktree)
🌐 **Google Jules Web Task:** https://jules.google.com/task/$SESSION_ID
EOF
)
        PR_TITLE="${CUSTOM_TITLE:-feat(jules): session $SESSION_ID}"
        if [[ "$SKIP_CI" == "true" && "$PR_TITLE" != *"[skip ci]"* ]]; then
            PR_TITLE="$PR_TITLE [skip ci]"
        fi

        resolve_gh_token
        echo "==> Pushing $REVIEW_BRANCH and creating Pull Request..."
        git push -u origin "$REVIEW_BRANCH"
        gh pr create --base "$BASE_BRANCH" --head "$REVIEW_BRANCH" --title "$PR_TITLE" --body "$PR_BODY"
        echo "✅ Pull request successfully created!"
        echo "🌐 Jules Web Task: https://jules.google.com/task/$SESSION_ID"

        if [[ "$AUTO_MERGE" == "true" ]]; then
            echo "==> [--auto-merge] Merging Pull Request for $REVIEW_BRANCH into $BASE_BRANCH..."
            "$0" pr-merge "$REVIEW_BRANCH" "$BASE_BRANCH" $([[ "$SKIP_CI" == "true" ]] && echo "--skip-ci" || true)
        fi
        ;;
    pr-merge)
        TARGET_REF="${1:-}"
        if [[ -z "$TARGET_REF" ]]; then
            echo "Usage: jules-gate pr-merge <branch_or_session_id> [base_branch] [--skip-ci]"
            exit 1
        fi
        shift
        BASE_BRANCH=""
        SKIP_CI=false
        if [[ "${JULES_GATE_SKIP_CI:-}" == "1" ]]; then
            SKIP_CI=true
        fi
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --skip-ci)
                    SKIP_CI=true
                    shift
                    ;;
                *)
                    if [[ -z "$BASE_BRANCH" ]]; then
                        BASE_BRANCH="$1"
                    fi
                    shift
                    ;;
            esac
        done

        BASE_BRANCH="${BASE_BRANCH:-$(git branch --show-current 2>/dev/null || echo 'main')}"
        if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
            if [[ "$BASE_BRANCH" == "main" ]] && git rev-parse --verify "master" >/dev/null 2>&1; then
                BASE_BRANCH="master"
            elif [[ "$BASE_BRANCH" == "master" ]] && git rev-parse --verify "main" >/dev/null 2>&1; then
                BASE_BRANCH="main"
            fi
        fi

        if [[ "$TARGET_REF" =~ ^[0-9]+$ ]]; then
            REVIEW_BRANCH="jules/review-${TARGET_REF}"
            if ! git rev-parse --verify "$REVIEW_BRANCH" >/dev/null 2>&1; then
                "$SCRIPTS_DIR/worktree_gate.sh" "$TARGET_REF" "$BASE_BRANCH" $([[ "$SKIP_CI" == "true" ]] && echo "--skip-ci" || true)
            fi
        else
            REVIEW_BRANCH="$TARGET_REF"
        fi

        ORIGINAL_DIR="$PWD"
        if git rev-parse --verify "$REVIEW_BRANCH" >/dev/null 2>&1; then
            PR_MERGE_WT=$(mktemp -d "/tmp/jules-pr-merge-XXXXXX")
            cleanup_pr_wt() {
                cd "$ORIGINAL_DIR" 2>/dev/null || true
                git worktree remove --force "$PR_MERGE_WT" 2>/dev/null || true
                rm -rf "$PR_MERGE_WT"
            }
            trap 'cleanup_pr_wt' EXIT INT TERM
            git worktree add --detach "$PR_MERGE_WT" "$REVIEW_BRANCH" >/dev/null 2>&1
            cd "$PR_MERGE_WT"
            export PYTHONPATH="${PR_MERGE_WT}/src:${PR_MERGE_WT}:${PYTHONPATH:-}"
            TEST_CMD=""
            if [[ -f "pyproject.toml" || -f "pytest.ini" || -f "setup.py" || -f "requirements.txt" || -n "$(find . -maxdepth 2 -name 'test_*.py' 2>/dev/null | head -n 1)" || (-d "tests" && -n "$(find tests -name '*.py' 2>/dev/null | head -n 1)") ]]; then
                if [[ -x "$ORIGINAL_DIR/.venv/bin/pytest" ]]; then
                    TEST_CMD="$ORIGINAL_DIR/.venv/bin/python -m pytest -q --tb=short"
                elif python3 -m pytest --version >/dev/null 2>&1; then
                    TEST_CMD="python3 -m pytest -q --tb=short"
                elif command -v uv >/dev/null 2>&1 && [[ -f "pyproject.toml" ]]; then
                    TEST_CMD="uv run pytest -q --tb=short"
                elif command -v pytest >/dev/null 2>&1 && pytest --version >/dev/null 2>&1; then
                    TEST_CMD="pytest -q --tb=short"
                else
                    TEST_CMD="python3 -m unittest discover -s . -p 'test_*.py'"
                fi
            elif [[ -f "package.json" ]] && grep -q '"test":' package.json; then
                TEST_CMD="npm test"
            elif [[ -f "Cargo.toml" ]]; then
                TEST_CMD="cargo test"
            elif [[ -f "go.mod" ]]; then
                TEST_CMD="go test ./..."
            fi
            if [[ -n "${JULES_GATE_TEST_CMD:-}" ]]; then
                TEST_CMD="$JULES_GATE_TEST_CMD"
            fi
            if [[ -n "$TEST_CMD" ]]; then
                echo "==> [pr-merge] Verifying local tests on $REVIEW_BRANCH: $TEST_CMD"
                TEST_LOG=$(mktemp "/tmp/jules-pr-test-XXXXXX")
                if $TEST_CMD > "$TEST_LOG" 2>&1; then
                    echo "✅ Local tests passed on $REVIEW_BRANCH!"
                    tail -n 3 "$TEST_LOG" | grep -E "passed|skipped|warning" || true
                    rm -f "$TEST_LOG"
                else
                    echo "❌ Local tests failed on $REVIEW_BRANCH. Aborting pr-merge."
                    tail -n 40 "$TEST_LOG"
                    rm -f "$TEST_LOG"
                    exit 3
                fi
            fi
            cd "$ORIGINAL_DIR"
            trap - EXIT INT TERM
            cleanup_pr_wt
        fi

        perform_pr_merge() {
            resolve_gh_token
            echo "==> Pushing updates for $REVIEW_BRANCH..."
            git push origin "$REVIEW_BRANCH" 2>/dev/null || true

            echo "==> Merging Pull Request for $REVIEW_BRANCH into $BASE_BRANCH..."
            if command -v gh >/dev/null 2>&1 && gh pr merge "$REVIEW_BRANCH" --merge --delete-branch 2>/dev/null; then
                echo "✅ Merged PR via GitHub CLI and deleted remote branch $REVIEW_BRANCH."
                git checkout "$BASE_BRANCH"
                git pull origin "$BASE_BRANCH" 2>/dev/null || true
                git branch -D "$REVIEW_BRANCH" 2>/dev/null || true
            else
                echo "==> Falling back to local --no-ff merge and push into $BASE_BRANCH..."
                git checkout "$BASE_BRANCH"
                git pull origin "$BASE_BRANCH" 2>/dev/null || true
                MERGE_MSG="merge(jules): merge $REVIEW_BRANCH into $BASE_BRANCH"
                if [[ "$SKIP_CI" == "true" ]]; then
                    MERGE_MSG="$MERGE_MSG [skip ci]"
                fi
                git merge --no-ff "$REVIEW_BRANCH" -m "$MERGE_MSG"
                git push origin "$BASE_BRANCH" 2>/dev/null || true
                git branch -d "$REVIEW_BRANCH" 2>/dev/null || true
                git push origin --delete "$REVIEW_BRANCH" 2>/dev/null || true
                echo "✅ Merged $REVIEW_BRANCH into $BASE_BRANCH locally and pushed to origin."
            fi
        }
        with_git_lock perform_pr_merge
        ;;
    review-branch|review-pr)
        TARGET_REF="${1:-}"
        if [[ -z "$TARGET_REF" ]]; then
            echo "Usage: jules-gate review-branch <branch_or_session_id> [base_branch] [--repo <owner/repo>]"
            exit 1
        fi
        shift
        BASE_BRANCH=""
        REPO=""
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --repo)
                    REPO="$2"
                    shift 2
                    ;;
                *)
                    if [[ -z "$BASE_BRANCH" ]]; then
                        BASE_BRANCH="$1"
                    fi
                    shift
                    ;;
            esac
        done
        BASE_BRANCH="${BASE_BRANCH:-$(git branch --show-current 2>/dev/null || echo 'main')}"
        if ! git rev-parse --verify "$BASE_BRANCH" >/dev/null 2>&1; then
            if [[ "$BASE_BRANCH" == "main" ]] && git rev-parse --verify "master" >/dev/null 2>&1; then
                BASE_BRANCH="master"
            elif [[ "$BASE_BRANCH" == "master" ]] && git rev-parse --verify "main" >/dev/null 2>&1; then
                BASE_BRANCH="main"
            fi
        fi
        if [[ "$TARGET_REF" =~ ^[0-9]+$ ]]; then
            REVIEW_BRANCH="jules/review-${TARGET_REF}"
        else
            REVIEW_BRANCH="$TARGET_REF"
        fi
        SAFE_NAME=$(echo "$REVIEW_BRANCH" | sed -E 's#[^A-Za-z0-9_-]#_#g')
        if [[ -z "$REPO" ]]; then
            REMOTE_URL=$(git remote get-url origin 2>/dev/null || true)
            if [[ -n "$REMOTE_URL" ]]; then
                REPO=$(echo "$REMOTE_URL" | sed -E 's#.*github\.com[:/]([^/]+/[^/.]+)(\.git)?$#\1#' || true)
            fi
        fi
        mkdir -p .jules
        DIFF_CONTENT=$(git diff "$BASE_BRANCH...$REVIEW_BRANCH" 2>/dev/null || true)
        PROMPT_FILE=".jules/review_prompt_${SAFE_NAME}.md"
        cat << EOF > "$PROMPT_FILE"
### Task: EULIS Senior Code Review & Security Audit of Branch $REVIEW_BRANCH

Please perform an in-depth senior engineering review of the branch changes relative to \`$BASE_BRANCH\`.

#### 1. Review Criteria:
1. Concurrency, State & Race Conditions
2. Boundary Conditions, Error Handling & Edge Cases
3. Security, Injection & Secret Hygiene
4. Test Coverage & Isolated Local Execution Completeness

#### 2. Deliverables:
- Author a detailed review proposal in \`docs/reviews/review_${SAFE_NAME}.md\`.
- Apply any recommended code or test fixes directly.
- Finalize your response directly with a summary without asking open-ended questions so the session cleanly transitions to Completed.

#### 3. Branch Diff (\`$BASE_BRANCH...$REVIEW_BRANCH\`):
\`\`\`diff
$DIFF_CONTENT
\`\`\`
EOF
        echo "📄 Generated review prompt at $PROMPT_FILE (target report: docs/reviews/review_${SAFE_NAME}.md)"
        if command -v jules >/dev/null 2>&1 && [[ -n "$REPO" && "${JULES_GATE_DRY_RUN:-}" != "1" ]]; then
            echo "==> Dispatching EULIS branch review to $REPO..."
            jules remote new --repo "$REPO" < "$PROMPT_FILE"
        else
            echo "💡 Dispatch with: jules remote new --repo <owner/repo> < $PROMPT_FILE"
        fi
        ;;
    lint|check)
        REPO="${1:-}"
        PROMPT_FILE="${2:-}"
        
        echo "=========================================================="
        echo " [Jules Gate] Pre-Dispatch Contract Linter"
        echo "=========================================================="
        
        LINT_PASSED=true
        
        # 1. Check Jules CLI installation
        if command -v jules >/dev/null 2>&1; then
            echo "  ✅ Jules CLI: $(command -v jules) detected"
        else
            echo "  ❌ Jules CLI: not found in PATH"
            LINT_PASSED=false
        fi
        
        # 2. Check Repository Connection
        if [[ -n "$REPO" ]]; then
            if command -v jules >/dev/null 2>&1; then
                CONNECTED_REPOS=$(jules remote list --repo 2>/dev/null || true)
                if echo "$CONNECTED_REPOS" | grep -q "$REPO"; then
                    echo "  ✅ Repository: '$REPO' is connected to Jules"
                else
                    echo "  ⚠️  Repository: '$REPO' not found in connected repos list"
                    echo "     Run 'jules remote list --repo' to verify"
                fi
            fi
        else
            echo "  ℹ️  Repository: none specified (syntax: jules-gate lint <owner/repo> [prompt_file])"
        fi
        
        # 3. Check Prompt File if provided
        if [[ -n "$PROMPT_FILE" ]]; then
            if [[ -f "$PROMPT_FILE" ]]; then
                PROMPT_SIZE=$(wc -c < "$PROMPT_FILE" | tr -d ' ')
                NON_EMPTY_LINES=$(grep -c '[^[:space:]]' "$PROMPT_FILE" || true)
                echo "  ✅ Prompt File: '$PROMPT_FILE' exists ($PROMPT_SIZE bytes, $NON_EMPTY_LINES non-empty lines)"
                if grep -qiE "target|file|path|test|assert|verify" "$PROMPT_FILE"; then
                    echo "  ✅ Contract Specification: Bounded file paths or acceptance tests detected"
                else
                    echo "  ⚠️  Contract Specification: Consider specifying exact target files or tests in prompt"
                fi

                # Automated Line-Count / Complexity Heuristic (Local Efficiency Override Check)
                if [[ "$NON_EMPTY_LINES" -le 2 ]]; then
                    echo "  ⚡ Efficiency Notice: Prompt is very concise ($NON_EMPTY_LINES lines)."
                    echo "     Candidate for Local Efficiency Override if this is a trivial 1-line syntax/import/config fix."
                    echo "     Direct local execution on the IDE thread may consume fewer tokens than cloud VM dispatch."
                fi

                # If prompt is a patch/diff file, inspect diff line count
                if [[ "$PROMPT_FILE" == *.patch || "$PROMPT_FILE" == *.diff ]] || grep -q "^@@ " "$PROMPT_FILE" 2>/dev/null; then
                    DIFF_LINES=$(grep -c '^[+-][^+-]' "$PROMPT_FILE" || true)
                    if [[ "$DIFF_LINES" -gt 0 && "$DIFF_LINES" -le 3 ]]; then
                        echo "  ⚡ Efficiency Notice: Patch targets only $DIFF_LINES lines of diff."
                        echo "     Candidate for Local Efficiency Override (cloud dispatch may consume more tokens than local edit)."
                    fi
                fi

                # Non-Interactive Conclusion Directive Check
                if grep -qiE "do not ask|non-interactive|without asking|finalize directly" "$PROMPT_FILE"; then
                    echo "  ✅ Completion Directive: Non-interactive conclusion directive detected"
                else
                    echo "  💡 Completion Tip: Add 'Finalize without asking open-ended questions' to avoid session staying in 'Awaiting User Feedback'"
                fi

                # Prompt-quality hints (lessons from slow sessions). Warnings only, they never fail the lint.
                PROHIBITIONS=$( (grep -oiE "(^|[^a-z])(do not|don't|never|must not|not allowed|forbidden)([^a-z]|$)" "$PROMPT_FILE" || true) | wc -l | tr -d " ")
                if [[ "$PROHIBITIONS" -ge 5 ]] && ! grep -qiE "fallback|otherwise|if .*(cannot|can't|not possible|blocked|fails)|default" "$PROMPT_FILE"; then
                    echo "  💡 Conflict Tip: $PROHIBITIONS prohibitions but no fallback. Add 'If a rule cannot be met, do <X> and say so; do not ask' (a session asked three questions for exactly this)"
                fi
                NON_EMPTY=$(grep -cvE '^[[:space:]]*$' "$PROMPT_FILE" || true)
                STEPS=$(grep -cE '^[0-9]+\. ' "$PROMPT_FILE" || true)
                if [[ "$NON_EMPTY" -gt 80 || "$STEPS" -gt 8 ]]; then
                    echo "  💡 Scope Tip: Long prompt ($NON_EMPTY lines, $STEPS numbered steps). One goal per session; split big work by module (long sessions took hours)"
                fi
                if grep -qiE "mypy|pytest|ruff|npm test|cargo test|go test|mvn " "$PROMPT_FILE" && ! grep -qiE "tail|head|cut -c|affected tests|only the .*test|-q( |$)" "$PROMPT_FILE"; then
                    echo "  💡 Output Tip: Limit tool output (e.g. 'run only the affected tests while working, the full suite once at the end; pipe noisy tools through tail/cut')"
                fi
                if ! grep -qiE "[A-Za-z0-9_./-]+\.(py|js|ts|go|rs|java|md|toml|yml|yaml|json|sh)|\b(src|tests|docs|scripts)/" "$PROMPT_FILE"; then
                    echo "  💡 Specificity Tip: Name the files or directories and the exact commands; specific prompts are faster and more reliable"
                fi
            else
                echo "  ❌ Prompt File: '$PROMPT_FILE' not found"
                LINT_PASSED=false
            fi
        fi
        
        # 4. Check Local Test Runner
        TEST_RUNNER="none"
        if [[ -f "pyproject.toml" || -f "pytest.ini" || -f "requirements.txt" || -n "$(find . -maxdepth 2 -name 'test_*.py' 2>/dev/null | head -n 1)" ]]; then
            TEST_RUNNER="pytest / python unittest"
        elif [[ -f "package.json" ]]; then
            TEST_RUNNER="npm test"
        elif [[ -f "Cargo.toml" ]]; then
            TEST_RUNNER="cargo test"
        elif [[ -f "go.mod" ]]; then
            TEST_RUNNER="go test"
        fi
        echo "  ✅ Project Test Runner: $TEST_RUNNER detected"
        
        echo "=========================================================="
        if [[ "$LINT_PASSED" == "true" ]]; then
            echo "🎉 Pre-flight checks passed! Ready for cloud dispatch."
            exit 0
        else
            echo "❌ Pre-flight checks failed. Please fix above errors before dispatch."
            exit 1
        fi
        ;;
    tokens)
        JSON_OUTPUT=false
        RESET=false
        while [[ $# -gt 0 ]]; do
            case "$1" in
                --json)
                    JSON_OUTPUT=true
                    shift
                    ;;
                --reset)
                    RESET=true
                    shift
                    ;;
                *)
                    shift
                    ;;
            esac
        done

        TELEMETRY_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/jules-gate"
        TELEMETRY_FILE="$TELEMETRY_DIR/telemetry.log"

        if [[ "$RESET" == "true" ]]; then
            rm -f "$TELEMETRY_FILE"
            echo "✅ Jules Gate telemetry cache has been reset."
            exit 0
        fi

        # Count remote completed and awaiting feedback sessions if jules CLI is available
        REMOTE_COMPLETED=0
        REMOTE_AWAITING=0
        if command -v jules >/dev/null 2>&1; then
            REMOTE_SESSIONS=$(jules remote list --session 2>/dev/null || true)
            if [[ -n "$REMOTE_SESSIONS" ]]; then
                REMOTE_COMPLETED=$(echo "$REMOTE_SESSIONS" | grep -c "Completed" || true)
                REMOTE_AWAITING=$(echo "$REMOTE_SESSIONS" | grep -c "Awaiting User" || true)
            fi
        fi
        TOTAL_REMOTE_DELIVERED=$(( REMOTE_COMPLETED + REMOTE_AWAITING ))

        # Parse local telemetry cache
        LOCAL_VERIFIED=0
        LOCAL_MERGED=0
        TOTAL_ADDED=0
        TOTAL_REMOVED=0
        CACHED_TOKENS_SAVED=0

        if [[ -f "$TELEMETRY_FILE" ]]; then
            while IFS='|' read -r ts sid repo status added removed tokens; do
                [[ -z "$sid" ]] && continue
                if [[ "$status" == "verified" ]]; then
                    LOCAL_VERIFIED=$(( LOCAL_VERIFIED + 1 ))
                elif [[ "$status" == "merged" ]]; then
                    LOCAL_MERGED=$(( LOCAL_MERGED + 1 ))
                fi
                TOTAL_ADDED=$(( TOTAL_ADDED + ${added:-0} ))
                TOTAL_REMOVED=$(( TOTAL_REMOVED + ${removed:-0} ))
                CACHED_TOKENS_SAVED=$(( CACHED_TOKENS_SAVED + ${tokens:-0} ))
            done < "$TELEMETRY_FILE"
        fi

        # Extrapolate savings for delivered remote sessions
        if [[ "$TOTAL_REMOTE_DELIVERED" -gt "$LOCAL_VERIFIED" ]]; then
            DELTA=$(( TOTAL_REMOTE_DELIVERED - LOCAL_VERIFIED ))
            EXTRAPOLATED_SAVINGS=$(( DELTA * 35000 ))
            ESTIMATED_TOTAL_TOKENS=$(( CACHED_TOKENS_SAVED + EXTRAPOLATED_SAVINGS ))
        else
            ESTIMATED_TOTAL_TOKENS="$CACHED_TOKENS_SAVED"
        fi

        TOTAL_DIFF_LINES=$(( TOTAL_ADDED + TOTAL_REMOVED ))
        ESTIMATED_USD=$(awk -v t="$ESTIMATED_TOTAL_TOKENS" 'BEGIN { printf "%.2f", (t / 1000000) * 5.0 }')

        if [[ "$JSON_OUTPUT" == "true" ]]; then
            cat << EOF
{
  "remote_completed_sessions": $REMOTE_COMPLETED,
  "remote_awaiting_feedback_sessions": $REMOTE_AWAITING,
  "remote_total_delivered_sessions": $TOTAL_REMOTE_DELIVERED,
  "local_verified_sessions": $LOCAL_VERIFIED,
  "local_merged_sessions": $LOCAL_MERGED,
  "lines_added_spared": $TOTAL_ADDED,
  "lines_removed_spared": $TOTAL_REMOVED,
  "total_diff_lines_spared": $TOTAL_DIFF_LINES,
  "estimated_tokens_spared": $ESTIMATED_TOTAL_TOKENS,
  "estimated_usd_value": $ESTIMATED_USD
}
EOF
            exit 0
        fi

        echo "=========================================================="
        echo " [Jules Gate] Token Economy & Sparing Telemetry"
        echo "=========================================================="
        echo "  📊 Session Counts:"
        echo "     • Remote Completed Sessions:  $REMOTE_COMPLETED (auto-closed)"
        echo "     • Remote Awaiting Feedback:   $REMOTE_AWAITING (patch ready, awaiting web UI close)"
        echo "     • Locally Verified Patches:   $LOCAL_VERIFIED"
        echo "     • Merged Review Branches:     $LOCAL_MERGED"
        echo ""
        echo "  ⚡ Code & Line Sparing:"
        echo "     • Total Diff Lines Spared:    $TOTAL_DIFF_LINES (+$TOTAL_ADDED / -$TOTAL_REMOVED)"
        echo ""
        echo "  💰 Cumulative Savings:"
        echo "     • Estimated Tokens Spared:    ~$ESTIMATED_TOTAL_TOKENS tokens"
        echo "     • Estimated Compute Value:    ~\$$ESTIMATED_USD USD"
        echo "=========================================================="
        echo "  Tip: Run 'jules-gate tokens --json' for machine-readable output"
        echo "  Tip: Run 'jules-gate web [session_id]' to open web task in browser"
        ;;
    close)
        SESSION_ID="${1:-}"
        if [[ -z "$SESSION_ID" ]]; then
            echo "❌ Error: session_id is required for close command."
            exit 1
        fi
        echo "✅ Task dismissal guidance: Please review the changes and close the session in the Web UI."
        URL="https://jules.google.com/task/$SESSION_ID"
        echo "🌐 Jules Web Task: $URL"
        open_browser_url "$URL"
        ;;
    reply)
        SESSION_ID="${1:-}"
        FILE_OR_MSG="${2:-}"
        if [[ -z "$SESSION_ID" || -z "$FILE_OR_MSG" ]]; then
            echo "❌ Error: session_id and file_or_message are required for reply command."
            exit 1
        fi
        
        # Check if FILE_OR_MSG is a file and readable
        if [[ -f "$FILE_OR_MSG" && -r "$FILE_OR_MSG" ]]; then
            CONTENT=$(cat "$FILE_OR_MSG")
            echo "📄 Reading content from file: $FILE_OR_MSG"
        else
            CONTENT="$FILE_OR_MSG"
            echo "💬 Using provided text message."
        fi
        
        # Copy to clipboard (only when interactive / browser enabled)
        if [[ "${JULES_GATE_NO_BROWSER:-}" != "1" && "${CI:-}" != "true" && "${TESTING:-}" != "true" ]]; then
            if command -v pbcopy >/dev/null 2>&1; then
                echo "$CONTENT" | pbcopy
                echo "📋 Copied content to clipboard (pbcopy)."
            elif command -v xclip >/dev/null 2>&1; then
                echo "$CONTENT" | xclip -selection clipboard
                echo "📋 Copied content to clipboard (xclip)."
            else
                echo "⚠️  Clipboard utilities (pbcopy/xclip) not found. Could not copy to clipboard."
            fi
        fi
        
        URL="https://jules.google.com/task/$SESSION_ID"
        echo "🌐 Opening Jules Web Task for rapid reply: $URL"
        open_browser_url "$URL"
        ;;
    inspect)
        SESSION_ID="${1:-}"
        if [[ -z "$SESSION_ID" ]]; then
            echo "Usage: jules-gate inspect <session_id> [--json]"
            exit 1
        fi
        python3 "$SCRIPTS_DIR/jules_api.py" inspect "$SESSION_ID" "${2:-}"
        ;;
    interact)
        SESSION_ID="${1:-}"
        MESSAGE="${2:-}"
        if [[ -z "$SESSION_ID" || -z "$MESSAGE" ]]; then
            echo "Usage: jules-gate interact <session_id> <message_or_file>"
            exit 1
        fi
        python3 "$SCRIPTS_DIR/jules_api.py" interact "$SESSION_ID" "$MESSAGE"
        ;;
    auto-answer)
        SESSION_ID="${1:-}"
        if [[ -z "$SESSION_ID" ]]; then
            echo "Usage: jules-gate auto-answer <session_id>"
            exit 1
        fi
        python3 "$SCRIPTS_DIR/jules_api.py" auto-answer "$SESSION_ID"
        ;;
    web|open)
        SESSION_ID="${1:-}"
        if [[ -n "$SESSION_ID" ]]; then
            URL="https://jules.google.com/task/$SESSION_ID"
        else
            URL="https://jules.google.com"
        fi
        echo "🌐 Opening Jules Web Task: $URL"
        open_browser_url "$URL"
        ;;
    ps|list)
        if command -v jules >/dev/null 2>&1; then
            exec jules remote list --session "$@"
        else
            echo "❌ Error: jules CLI is not installed or not in PATH."
            exit 1
        fi
        ;;
    workflow)
        exec python3 "$SCRIPTS_DIR/workflow_engine.py" "$@"
        ;;
    status)
        PLUGIN_JSON=""
        if [[ -f "$ROOT_DIR/plugin.json" ]]; then
            PLUGIN_JSON="$ROOT_DIR/plugin.json"
        elif [[ -f "$HOME/.gemini/config/plugins/jules-plugin/plugin.json" ]]; then
            PLUGIN_JSON="$HOME/.gemini/config/plugins/jules-plugin/plugin.json"
        fi

        VERSION="unknown"
        if [[ -n "$PLUGIN_JSON" && -f "$PLUGIN_JSON" ]]; then
            VERSION=$(grep '"version"' "$PLUGIN_JSON" | head -n 1 | sed -E 's/.*"version": *"([^"]+)".*/\1/')
        fi

        POLL_WAIT_SCRIPT="$SCRIPTS_DIR/jules_poll_wait.sh"
        WORKTREE_GATE_SCRIPT="$SCRIPTS_DIR/worktree_gate.sh"
        WORKFLOW_ENGINE_SCRIPT="$SCRIPTS_DIR/workflow_engine.py"

        echo "Plugin version: $VERSION"
        JULES_CLI="not found in PATH"
        if command -v jules >/dev/null 2>&1; then
            JULES_CLI="$(command -v jules)"
        fi
        echo "Jules CLI: $JULES_CLI"
        echo "Scripts:"

        ALL_EXEC=true
        if [[ -f "$POLL_WAIT_SCRIPT" ]]; then
            if [[ -x "$POLL_WAIT_SCRIPT" ]]; then
                echo "  - $POLL_WAIT_SCRIPT: executable"
            else
                echo "  - $POLL_WAIT_SCRIPT: not executable"
                ALL_EXEC=false
            fi
        else
            echo "  - $POLL_WAIT_SCRIPT: not found"
            ALL_EXEC=false
        fi

        if [[ -f "$WORKTREE_GATE_SCRIPT" ]]; then
            if [[ -x "$WORKTREE_GATE_SCRIPT" ]]; then
                echo "  - $WORKTREE_GATE_SCRIPT: executable"
            else
                echo "  - $WORKTREE_GATE_SCRIPT: not executable"
                ALL_EXEC=false
            fi
        else
            echo "  - $WORKTREE_GATE_SCRIPT: not found"
            ALL_EXEC=false
        fi

        if [[ -f "$WORKFLOW_ENGINE_SCRIPT" ]]; then
            if [[ -x "$WORKFLOW_ENGINE_SCRIPT" ]]; then
                echo "  - $WORKFLOW_ENGINE_SCRIPT: executable"
            else
                echo "  - $WORKFLOW_ENGINE_SCRIPT: not executable"
                ALL_EXEC=false
            fi
        else
            echo "  - $WORKFLOW_ENGINE_SCRIPT: not found"
            ALL_EXEC=false
        fi

        if [[ "$ALL_EXEC" != "true" ]]; then
            exit 1
        fi
        ;;
    -h|--help|help)
        usage
        ;;
    *)
        echo "Unknown command: $CMD"
        usage
        ;;
esac
